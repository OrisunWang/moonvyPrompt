{
  "name": "moonvy-ui-prompt",
  "version": "0.1.0",
  "description": "Convert Moonvy design URLs into AI-ready UI tree JSON and implementation prompts.",
  "type": "module",
  "bin": {
    "moonvy-ui-prompt": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "moonvy",
    "design-to-code",
    "ui-tree",
    "ai-prompt"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "sharp": "^0.35.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrisunWang/moonvyPrompt.git"
  },
  "homepage": "https://github.com/OrisunWang/moonvyPrompt#readme",
  "bugs": {
    "url": "https://github.com/OrisunWang/moonvyPrompt/issues"
  }
}
